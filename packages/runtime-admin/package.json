{
  "name": "@imprint/runtime-admin",
  "version": "0.12.0",
  "private": true,
  "description": "Engine runtime (and, from Fase 3, the shared admin): the page renderer and layout helpers every Imprint site uses. Knows no concrete widget; a site hands in its catalogue.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./layout": "./src/layout.ts",
    "./admin": "./src/admin/index.ts",
    "./forms": "./src/forms.ts",
    "./admin-server": "./src/admin-server/index.ts",
    "./studio": "./src/studio/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@imprint/content-core": "*",
    "@imprint/extension-api": "*",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "exifr": "^7.1.3",
    "marked": "^14.1.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.0",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/turndown": "^5.0.5",
    "typescript": "^5"
  }
}
