{
  "name": "@imprint/content-core",
  "version": "0.10.2",
  "private": true,
  "description": "Content schemas (zod) and the ContentStore interface. Storage-agnostic: file-backed, MariaDB or Postgres (bitemporal-light).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./store": "./src/store.ts",
    "./file-store": "./src/file-store.ts",
    "./db-schema": "./src/db-schema.ts",
    "./db-store": "./src/db-store.ts",
    "./db-store.pg": "./src/db-store.pg.ts",
    "./db-schema.pg": "./src/db-schema.pg.ts",
    "./db": "./src/db.ts",
    "./memory-store": "./src/memory-store.ts",
    "./passwords": "./src/passwords.ts",
    "./user-store": "./src/user-store.ts",
    "./user-store.pg": "./src/user-store.pg.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "gray-matter": "^4.0.3",
    "mysql2": "^3.14.1",
    "pg": "^8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "typescript": "^5"
  }
}
