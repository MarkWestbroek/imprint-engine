{
  "name": "@imprint/plugin-patches",
  "version": "0.14.0",
  "private": true,
  "description": "Plugin: a patch pool — patches (files from the editor) as a content type with pools (voorstel, experimenteel, centraal, vraag), an ingest API for the editor, and pages to browse, listen and open in the editor.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./content-types": "./src/content-types.ts",
    "./href": "./src/href.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@imprint/content-core": "*",
    "@imprint/extension-api": "*",
    "@imprint/runtime-admin": "*",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
