{
  "name": "@imprint/plugin-taal",
  "version": "0.15.0",
  "private": true,
  "description": "Plugin: language training — lessons (dialogue, chunks, exercises) as a content type, the widgets lesdialoog and oefeningen, a page per lesson under /<ui>/<package>/<lesson>, and Azure TTS audio as an admin action.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./content-types": "./src/content-types.ts",
    "./href": "./src/href.ts",
    "./audio": "./src/audio.ts",
    "./tekst": "./src/tekst.ts",
    "./tts": "./src/tts.ts",
    "./import": "./src/import.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@imprint/content-core": "*",
    "@imprint/extension-api": "*",
    "@imprint/runtime-admin": "*",
    "gray-matter": "^4.0.3",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
