{
  "name": "@imprint/plugin-presentations",
  "version": "0.15.0",
  "private": true,
  "description": "Plugin: presentations — a deck of slides (fixed 1920×1080 HTML canvases) as a content type, the speaker notes kept apart, and a widget that shows the slides scaled, with previous/next, keys and fullscreen.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./content-types": "./src/content-types.ts",
    "./import": "./src/import.ts",
    "./sanitize": "./src/sanitize.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@imprint/content-core": "*",
    "@imprint/extension-api": "*",
    "@imprint/runtime-admin": "*",
    "zod": "^4.1.5",
    "lucide-react": "^0.468.0",
    "react-dom": "^19.2.4"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
