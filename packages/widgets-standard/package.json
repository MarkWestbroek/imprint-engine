{
  "name": "@imprint/widgets-standard",
  "version": "0.10.2",
  "private": true,
  "description": "Library: the standard Imprint widgets (text, table, image, gallery, map, hero, list, template, api, …) — config schemas (React-free) and server viewers. A site picks the ones it wants.",
  "type": "module",
  "exports": {
    "./schemas": "./src/schemas.ts",
    "./viewers": "./src/viewers.tsx",
    "./media": "./src/media-islands.tsx",
    "./editors": "./src/editors.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@imprint/content-core": "*",
    "@imprint/runtime-admin": "*",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "leaflet": "^1.9.4",
    "mermaid": "^12.0.0",
    "mustache": "^4.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
