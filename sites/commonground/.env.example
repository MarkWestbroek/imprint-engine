# Common Ground showcase database (Postgres, npm run db:up; create it once, see README).
DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/commonground
# Signs the admin session cookie; any long random string. Without it nobody can sign in.
SESSION_SECRET=change-me
