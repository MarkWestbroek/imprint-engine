# Common Ground showcase database (Postgres, npm run db:up; create it once, see README).
DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/commonground
# Signs the admin session cookie; any long random string. Without it nobody can sign in.
SESSION_SECRET=change-me
# Mail for members' verification links (design/mail.md): the Quickhost relay of the sender's domain, port 465.
# Without SMTP_HOST the link is shown on screen in development and registration says "not configured" in production.
# SMTP_HOST=mail.common-ground-lab.nl
# SMTP_PORT=465
# SMTP_USER=noreply@common-ground-lab.nl
# SMTP_PASS=
# MAIL_FROM="Common Ground (showcase) <noreply@common-ground-lab.nl>"
# Omnium render API for the V3 model diagram widget (render-svc locally; without it the interim drawer is used).
# OMNIUM_URL=http://127.0.0.1:8095
