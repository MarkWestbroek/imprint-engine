# markwestbroek.nl database (Postgres, npm run db:up; create it once, see README).
DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/markwestbroek
# Signs the admin session cookie; any long random string.
SESSION_SECRET=
# Dev only: hosts of other devices that may load the dev server, e.g. a phone (comma-separated).
# DEV_ORIGINS=192.168.2.10
# The contact form (widget "contact"): SMTP relay, sender, and where the messages go.
# Without these the form only logs the message in development.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Mark Westbroek <noreply@markwestbroek.nl>"
# CONTACT_TO=
