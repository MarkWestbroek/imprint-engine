# Inrichting-site database (Postgres, npm run db:up; create it once, see README).
DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/inrichting
# Signs the session cookie; any long random string. Without it nobody can sign in.
SESSION_SECRET=change-me
# The Omnium register (read-only). Locally e.g. a port-forward to omnium-api on Fundament.
OMNIUM_REGISTER_URL=http://127.0.0.1:8080
# A reader's personal token (omt_…); never commit it.
# OMNIUM_REGISTER_TOKEN=
# Omnium render API (v3model, diagrams).
# OMNIUM_URL=http://127.0.0.1:8095
