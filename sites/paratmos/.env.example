# paratmos.nl database (Postgres, npm run db:up; create it once, see README).
DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/paratmos
# Signs the admin session cookie; any long random string.
SESSION_SECRET=
# The contact form (widget "contact"): SMTP relay, sender, and where the messages go.
# Without these the form only logs the message in development.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Paratmos <noreply@paratmos.nl>"
# CONTACT_TO=
