# Taal-site database (Postgres, npm run db:up; create it once, see README).
DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/taal
# Signs the admin session cookie; any long random string. Without it nobody can sign in.
SESSION_SECRET=change-me
# Azure text-to-speech for the recordings (admin → Taal → Audio). Never commit the key.
# Without it the site reads sentences with the browser's own voice.
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=westeurope
