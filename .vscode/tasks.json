{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Imprint: dev (musicbrain)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.|Compiling",
          "endsPattern": "Ready in|Compiled"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Imprint: dev stoppen",
      "type": "npm",
      "script": "dev:stop",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Imprint: dev herstarten",
      "type": "npm",
      "script": "dev:restart",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Imprint: dev status",
      "type": "npm",
      "script": "dev:status",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Imprint: build (musicbrain)",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Imprint: typecheck + lint",
      "type": "shell",
      "command": "npm run typecheck; npm run lint",
      "problemMatcher": ["$tsc"]
    }
  ]
}
