# Copy to .env (repo root, for db tooling: drizzle-kit, seed) AND to
# sites/musicbrain/.env.local (for the Next.js app). Without DATABASE_URL the
# site falls back to the file-backed store (v0 behaviour).

# Local dev (docker-compose). The scheme picks the backend: mysql:// → MariaDB
# (MusicBrain), postgres:// → Postgres (the Imprint product site, port 5434).
DATABASE_URL=mysql://imprint:imprint-dev@localhost:3306/musicbrain
# sites/imprint/.env.local:
# DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/imprint
# Plesk production looks like:
# DATABASE_URL=mysql://mwestbro_user:***@localhost:3306/mwestbro_musicbrain

# Throwaway database for the DbContentStore tests (npm run test:db). The name
# MUST end in _test: the suite drops and recreates the tables. Create it once:
#   docker compose exec -T db mariadb -uroot -pimprint-root -e \
#     "CREATE DATABASE IF NOT EXISTS imprint_test; GRANT ALL ON imprint_test.* TO 'imprint'@'%';"
# TEST_DATABASE_URL=mysql://imprint:imprint-dev@localhost:3306/imprint_test
# The Postgres twin (created automatically by the compose service):
# TEST_PG_DATABASE_URL=postgres://imprint:imprint-dev@localhost:5434/imprint_test

# Secret for signing the /admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Used by db:seed ONLY, to create the first admin user. The user then lives in
# the database (hashed) — the running app never reads these. Safe to remove
# after the first seed; you only need them again to seed a fresh/empty database.
SEED_ADMIN_USER=mark
SEED_ADMIN_PASSWORD=

# Bearer token for the write-API (POST /api/content, POST /api/ingest/*) —
# product-projects use this to push content and assets. Empty = writes off.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKEN=

# AssetStore (uploaded board renders/pinouts). Defaults are fine locally; on
# Plesk point ASSET_ROOT at a persistent dir outside the app (survives deploys).
# ASSET_ROOT=/var/www/vhosts/example.com/imprint-assets
# ASSET_BASE_URL=/api/assets

# Wiki-publicatie (knop "Publiceer → live" in de wiki-studio): het doel en
# zijn INGEST_TOKEN. Alleen nodig in je LOKALE sites/musicbrain/.env.local —
# live heeft dit niet nodig. Leeg = knop geeft een nette melding.
# PUBLISH_URL=https://musicbrain.nl
# PUBLISH_TOKEN=<het INGEST_TOKEN van live>
