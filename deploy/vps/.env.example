# Kopieer naar deploy/vps/.env op de VPS (chmod 600) — nooit committen.
# Genereer elk geheim apart:  openssl rand -hex 24
# Hex, omdat de wachtwoorden in een postgres://-URL komen: geen tekens die je
# zou moeten URL-encoden.

# Welke sites ./deploy.sh (en backup.sh) standaard meeneemt. Zolang MusicBrain
# nog niet is verhuisd: alleen imprint.
SITES=imprint

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
MUSICBRAIN_DB_PASSWORD=
IMPRINT_DB_PASSWORD=
# PG_PORT=5434            # loopback-poort op de host (Omnium zit op 5433)

# ── musicbrain.nl ───────────────────────────────────────────────────────────
# Vul de SESSION_SECRET ook in als de site nog niet draait (compose eist hem).
# Neem SESSION_SECRET, INGEST_TOKEN en GITHUB_WEBHOOK_SECRET over uit de
# Plesk-omgeving (overdracht.md §0.2 stap 1), dan blijven sessies en de
# publicatieknop van de wiki-studio werken.
MUSICBRAIN_SESSION_SECRET=
MUSICBRAIN_INGEST_TOKEN=
MUSICBRAIN_GITHUB_WEBHOOK_SECRET=
# MUSICBRAIN_PORT=3000

# ── imprint-engine.nl ───────────────────────────────────────────────────────
IMPRINT_SESSION_SECRET=
IMPRINT_INGEST_TOKEN=
# IMPRINT_PORT=3100

# ── alleen voor de eerste seed (deploy.sh seed <site>) ──────────────────────
# De gebruiker staat daarna gehasht in de database; haal het wachtwoord hier
# na de eerste seed weer weg.
SEED_ADMIN_USER=mark
SEED_ADMIN_PASSWORD=
