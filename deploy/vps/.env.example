# Kopieer naar deploy/vps/.env op de VPS (chmod 600) — nooit committen.
# Genereer elk geheim apart:  openssl rand -hex 24
# Hex, omdat de wachtwoorden in een postgres://-URL komen: geen tekens die je
# zou moeten URL-encoden.

# Welke sites ./deploy.sh (en backup.sh) standaard meeneemt. Zolang MusicBrain
# nog niet is verhuisd: alleen imprint.
SITES=imprint

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
MUSICBRAIN_DB_PASSWORD=
IMPRINT_DB_PASSWORD=
COMMONGROUND_DB_PASSWORD=
# PG_PORT=5434            # loopback-poort op de host (Omnium zit op 5433)

# ── musicbrain.nl ───────────────────────────────────────────────────────────
# Vul de SESSION_SECRET ook in als de site nog niet draait (compose eist hem).
# Neem SESSION_SECRET, INGEST_TOKEN en GITHUB_WEBHOOK_SECRET over uit de
# Plesk-omgeving (overdracht.md §0.2 stap 1), dan blijven sessies en de
# publicatieknop van de wiki-studio werken.
MUSICBRAIN_SESSION_SECRET=
MUSICBRAIN_INGEST_TOKEN=
MUSICBRAIN_GITHUB_WEBHOOK_SECRET=
# MUSICBRAIN_PORT=3000

# ── imprint-engine.nl ───────────────────────────────────────────────────────
IMPRINT_SESSION_SECRET=
IMPRINT_INGEST_TOKEN=
# IMPRINT_PORT=3100

# ── commonground.imprint-engine.nl (showcase, design/communities.md) ───────
COMMONGROUND_SESSION_SECRET=
# COMMONGROUND_PORT=3400
# Mail for members' verification links (design/mail.md): a mailbox at Quickhost, port 465.
COMMONGROUND_SMTP_HOST=mail.common-ground-lab.nl
COMMONGROUND_SMTP_USER=noreply@common-ground-lab.nl
COMMONGROUND_SMTP_PASS=
COMMONGROUND_MAIL_FROM="Common Ground (showcase) <noreply@common-ground-lab.nl>"

# ── alleen voor de eerste seed (deploy.sh seed <site>) ──────────────────────
# De gebruiker staat daarna gehasht in de database; haal het wachtwoord hier
# na de eerste seed weer weg.
SEED_ADMIN_USER=mark
SEED_ADMIN_PASSWORD=

# Assets in een eigen MinIO-bucket per site (design/beeldbibliotheek.md §8),
# in de MinIO van deze stack (dienst `minio`). ENDPOINT leeg laten = op het
# Docker-volume. Volgorde: MINIO_ROOT_PASSWORD en de SECRET_KEY's invullen →
# ./deploy.sh s3-setup <site> → ./deploy.sh s3-move <site> --apply →
# <SITE>_S3_ENDPOINT=http://minio:9000 → SITES=<site> ./deploy.sh
# (docs/deploy-vps.md, "Assets naar MinIO").
MINIO_ROOT_USER=imprint-admin
MINIO_ROOT_PASSWORD=
MUSICBRAIN_S3_ENDPOINT=
MUSICBRAIN_S3_BUCKET=imprint-musicbrain
MUSICBRAIN_S3_ACCESS_KEY=imprint-musicbrain
MUSICBRAIN_S3_SECRET_KEY=
IMPRINT_S3_ENDPOINT=
IMPRINT_S3_BUCKET=imprint-imprint
IMPRINT_S3_ACCESS_KEY=imprint-imprint
IMPRINT_S3_SECRET_KEY=
