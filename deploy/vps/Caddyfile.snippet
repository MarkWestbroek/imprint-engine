# Blokken voor /etc/caddy/Caddyfile op de VPS (de bron van die Caddyfile staat
# in het Bitemporal-repo: bitemp_register_v06/deploy/vps/Caddyfile — het
# (veilig)-snippet staat daar bovenaan). Na wijzigen: sudo systemctl reload caddy
#
# Alle blokken hieronder staan sinds 19 september 2026 live; de log-blokken
# (bezoekstatistiek, stats.sh) sinds 5 oktober 2026.
#
# Zet een nieuw blok pas aan als het A-record naar de VPS wijst; anders blijft Caddy
# vergeefs een certificaat proberen op te halen. Geen AAAA naar een
# parkeeradres laten staan: dat breekt Let's Encrypt.

musicbrain.nl {
	import veilig
	log {
		output file /var/log/caddy/musicbrain.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
			mode 0644
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			request>uri query {
				delete token
			}
		}
	}
	# Uploads via de admin en /api/ingest (board-renders, 3D-modellen).
	request_body {
		max_size 50MB
	}
	reverse_proxy 127.0.0.1:3000
}

www.musicbrain.nl {
	redir https://musicbrain.nl{uri} permanent
}

imprint-engine.nl {
	import veilig
	log {
		output file /var/log/caddy/imprint.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
			mode 0644
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			request>uri query {
				delete token
			}
		}
	}
	reverse_proxy 127.0.0.1:3100
}

www.imprint-engine.nl {
	redir https://imprint-engine.nl{uri} permanent
}

# Showcase Common Ground op Imprint (design/communities.md); live sinds
# 30 september 2026.
commonground.imprint-engine.nl {
	import veilig
	log {
		output file /var/log/caddy/commonground.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
			mode 0644
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			request>uri query {
				delete token
			}
		}
	}
	reverse_proxy 127.0.0.1:3400
}

# Het tijdelijke adres van de productsite (19 september 2026) stuurt door.
imprint.musicbrain.nl {
	redir https://imprint-engine.nl{uri} permanent
}
