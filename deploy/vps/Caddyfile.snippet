# markwestbroek.nl: Marks persoonlijke site (live sinds 15 november 2026).
# Alleen markwestbroek.nl, www en woonwagen wijzen naar de VPS (eigen
# A-records); de wildcard, mail, webmail, pf (Adobe Portfolio) en pi blijven
# bij Quickhost.
markwestbroek.nl {
	import veilig
	log {
		output file /var/log/caddy/markwestbroek.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
			mode 0644
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			request>uri query {
				delete token
			}
		}
	}
	reverse_proxy 127.0.0.1:3800
}

www.markwestbroek.nl {
	redir https://markwestbroek.nl{uri} permanent
}

# De woonwagen is een sectie van dezelfde site (/woonwagen), geen eigen
# instantie: het subdomein is alleen een korte ingang. Tijdelijk; na de
# renovatie kan dit blok weg.
woonwagen.markwestbroek.nl {
	redir https://markwestbroek.nl/woonwagen{uri} 302
}

# paratmos.nl: de zakelijke site van Paratmos. NOG NIET LIVE: pas aanzetten als
# de A-records van paratmos.nl en www naar de VPS wijzen. De DNS staat bij
# Exsilia (Plesk, DNS Settings); mail, de MX- en de SPF-record en
# oud.paratmos.nl (het oude WordPress) blijven daar: alleen deze twee
# A-records omzetten.
paratmos.nl {
	import veilig
	log {
		output file /var/log/caddy/paratmos.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
			mode 0644
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			request>uri query {
				delete token
			}
		}
	}
	# De adressen van de oude WordPress-site (/?page_id=…, /?p=…), zodat links
	# op LinkedIn en in oude mails blijven werken. De drie dienstenpagina's
	# zijn nu één pagina; de Engelse pagina heeft (nog) geen tegenhanger.
	@wp_ea {
		path /
		query page_id=20
	}
	@wp_training {
		path /
		query page_id=23
	}
	@wp_tools {
		path /
		query page_id=26
	}
	@wp_over {
		path /
		query page_id=63
	}
	@wp_contact {
		path /
		query page_id=14
	}
	@wp_en {
		path /
		query page_id=79
	}
	@wp_post {
		path /
		query p=*
	}
	redir @wp_ea /modelgedreven-werken permanent
	redir @wp_training /diensten permanent
	redir @wp_tools /diensten permanent
	redir @wp_over /over permanent
	redir @wp_contact /contact permanent
	redir @wp_en / permanent
	redir @wp_post /blog permanent
	# Wat WordPress verder aanbood, bestaat niet meer.
	@wp_rest path /wp-admin* /wp-login.php /wp-content/* /wp-includes/* /xmlrpc.php /feed* /comments/feed*
	respond @wp_rest 410
	reverse_proxy 127.0.0.1:3900
}

www.paratmos.nl {
	redir https://paratmos.nl{uri} permanent
}

# Het tijdelijke adres van de productsite (19 september 2026) stuurt door.
imprint.musicbrain.nl {
	redir https://imprint-engine.nl{uri} permanent
}
