{
  "name": "imprint",
  "version": "0.10.2",
  "private": true,
  "description": "Imprint — one publishing engine, many brand sites (imprints). Reusable content core + per-site front-ends. First imprint: MusicBrain.",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=musicbrain",
    "dev:imprint": "npm run dev --workspace=@imprint/site -- --port 3100",
    "dev:start": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:restart": "node scripts/dev-server.mjs restart",
    "dev:status": "node scripts/dev-server.mjs status",
    "build": "npm run build --workspace=musicbrain && npm run build --workspace=@imprint/site",
    "start": "npm run start --workspace=musicbrain",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "user": "tsx scripts/user.ts",
    "user:passwd": "tsx scripts/user.ts passwd",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "testcase:bitemporal": "node scripts/testcase-bitemporal.mjs",
    "backup": "node scripts/backup.mjs",
    "assets:gc": "node scripts/assets-gc.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
