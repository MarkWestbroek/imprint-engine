{
  "name": "imprint",
  "version": "0.7.1",
  "private": true,
  "description": "Imprint — one publishing engine, many brand sites (imprints). Reusable content core + per-site front-ends. First imprint: MusicBrain.",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=musicbrain",
    "build": "npm run build --workspace=musicbrain",
    "start": "npm run start --workspace=musicbrain",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
